	<!--
		For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

		The following attributes can be set on the <httpRuntime> tag.
			<system.Web>
				<httpRuntime targetFramework="4.8" />
			</system.Web>
	-->
	<system.web>
		<httpRuntime executionTimeout="50000" maxRequestLength="1048576" appRequestQueueLimit="100"/>
		<compilation debug="true" targetFramework="4.8">
			<assemblies>
				<add assembly="DevExpress.Web.v16.2, Version=16.2.8.0, Culture=neutral, PublicKeyToken=B88D1754D700E49A"/>
