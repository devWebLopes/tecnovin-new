# ─────────────────────────────────────────────
# Variáveis de Ambiente de Produção (VPS Hostinger)
# Salvar como /opt/gestaonew/.env na VPS
# ─────────────────────────────────────────────

# ── VPN FortiClient SSL VPN (sidecar openfortivpn) ──
# Obrigatória: a API só alcança o Oracle através deste túnel.
VPN_HOST=vpn1.tecnovin.com.br
VPN_PORT=10443
VPN_USERNAME=tecnovin
VPN_PASSWORD=SUA_SENHA_VPN_AQUI
# Realm da FortiGate (opcional — deixe vazio se não usar)
VPN_REALM=
# Fingerprint SHA-256 do certificado do gateway (opcional, recomendado se o cert for autoassinado).
# Para descobrir:
#   openssl s_client -connect vpn1.tecnovin.com.br:10443 </dev/null 2>/dev/null | openssl x509 -fingerprint -sha256 -noout
VPN_TRUSTED_CERT=
# Último recurso: aceita qualquer certificado (1 = aceita). NÃO recomendado em produção.
VPN_INSECURE_SSL=0

# Oracle Database
ORACLE_CONNECTION_STRING=Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.1.4)(PORT=1526)))(CONNECT_DATA=(SERVICE_NAME=TECNOVIN)));User ID=treisbi;Password=SUA_SENHA_AQUI;

# JWT Authentication
JWT_SECRET=e4b6a3e8f2c1d7a9b0d5e8f3a2c6b9d1e7f4a8b0c3d5e2f9a1b7c4d0e8f3a6b2
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=7

# Imagens Docker (Geradas automaticamente pelo CI/CD)
API_IMAGE=ghcr.io/seu-usuario-ou-org/gestaonew/api:latest
WEB_IMAGE=ghcr.io/seu-usuario-ou-org/gestaonew/web:latest
